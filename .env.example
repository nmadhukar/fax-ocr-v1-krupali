# =============================================================================
# Healthcare Fax OCR - Configuration Template (NO paid APIs)
# =============================================================================

# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg2://faxadmin:faxpass123@localhost:5432/fax_processor
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_NAME=fax-documents
MINIO_TEMPLATES_BUCKET=templates

# OCR (PaddleOCR PP-OCRv5 - local, no API key)
OCR_ENABLE_GPU=false
OCR_DPI_TARGET=300
OCR_LANG=en
OCR_USE_ANGLE_CLS=true

# Template Matching
TEMPLATE_PHASH_THRESHOLD=10
TEMPLATE_ORB_MIN_MATCHES=20
TEMPLATE_MATCH_MIN_SCORE=0.75


# Embeddings (sentence-transformers, local)
EMBEDDER_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Confidence Thresholds
CONFIDENCE_AUTO_FINALIZE=0.90
CONFIDENCE_FIELD_MIN=0.70
CONFIDENCE_CRITICAL_FIELD_MIN=0.85

# Feature Flags
ENABLE_VLM=true
ENABLE_LLM_EXTRACTION=false
ENABLE_LLM_VALIDATION=false
ENABLE_VECTOR_SEARCH=true
ENABLE_FEEDBACK_LOOP=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_LOG_LEVEL=INFO
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001,http://localhost:8002,http://localhost:8003
API_MAX_UPLOAD_SIZE_MB=50

# Security
SECRET_KEY=your-secret-key-change-in-production
